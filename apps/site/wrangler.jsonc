{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sb-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Served only on the custom domain (the zone is in this Cloudflare account; the
  // API token needs Zone > Workers Routes > Edit on it).
  "routes": [{ "pattern": "slopbucket.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  // The running Worker version (its ID, and the tag deploy.yml sets to the git
  // commit), shown in the admin footer.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Cloudflare Access application guarding /admin (not secret: the middleware
  // verifies each request's Access JWT signature against the team's public keys).
  "vars": {
    "ACCESS_AUD": "4c6876fe1d52a71edf75ed851d0cddd7ead9384fb34b297082363df1f61c1b06",
    "ACCESS_TEAM_DOMAIN": "andyshinn.cloudflareaccess.com"
  },

  // The admin status panel enqueues fetch and classify jobs; sb-ingest consumes them.
  "queues": {
    "producers": [
      { "binding": "FETCH_QUEUE", "queue": "sb-fetch" },
      { "binding": "CLASSIFY_QUEUE", "queue": "sb-classify" }
    ]
  },

  // Per-IP rate limits (the namespace IDs are arbitrary, unique per account).
  // PAGE_LIMITER counts public page renders that miss the edge cache, so no one
  // can run D1 queries in a loop; REPORT_LIMITER counts report submissions.
  "ratelimits": [
    { "name": "PAGE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "REPORT_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],

  // Extracted article text (written by sb-ingest), shown in the admin review queue.
  "r2_buckets": [{ "binding": "ARTICLES", "bucket_name": "sb-articles" }],

  // database_id is written by .github/workflows/bootstrap.yml (or rename.yml).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sb",
      "database_id": "4754e0fd-99e0-4b08-8bfa-21a3a6572478",
      "migrations_dir": "../../migrations"
    }
  ]
}
