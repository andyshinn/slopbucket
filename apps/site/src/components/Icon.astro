---
// Heroicons (20px solid), inlined as SVG so no icon font or JS is needed.
import arrowDown from "heroicons/20/solid/arrow-down.svg?raw";
import arrowPath from "heroicons/20/solid/arrow-path.svg?raw";
import arrowTopRight from "heroicons/20/solid/arrow-top-right-on-square.svg?raw";
import arrowUp from "heroicons/20/solid/arrow-up.svg?raw";
import arrowsRightLeft from "heroicons/20/solid/arrows-right-left.svg?raw";
import bars3 from "heroicons/20/solid/bars-3.svg?raw";
import chartBar from "heroicons/20/solid/chart-bar.svg?raw";
import check from "heroicons/20/solid/check.svg?raw";
import chevronDown from "heroicons/20/solid/chevron-down.svg?raw";
import chevronRight from "heroicons/20/solid/chevron-right.svg?raw";
import codeBracket from "heroicons/20/solid/code-bracket.svg?raw";
import cog from "heroicons/20/solid/cog-6-tooth.svg?raw";
import cube from "heroicons/20/solid/cube.svg?raw";
import exclamation from "heroicons/20/solid/exclamation-triangle.svg?raw";
import flag from "heroicons/20/solid/flag.svg?raw";
import forward from "heroicons/20/solid/forward.svg?raw";
import inbox from "heroicons/20/solid/inbox.svg?raw";
import lockClosed from "heroicons/20/solid/lock-closed.svg?raw";
import magnifyingGlass from "heroicons/20/solid/magnifying-glass.svg?raw";
import moon from "heroicons/20/solid/moon.svg?raw";
import pencil from "heroicons/20/solid/pencil-square.svg?raw";
import play from "heroicons/20/solid/play.svg?raw";
import plus from "heroicons/20/solid/plus.svg?raw";
import star from "heroicons/20/solid/star.svg?raw";
import sun from "heroicons/20/solid/sun.svg?raw";
import tag from "heroicons/20/solid/tag.svg?raw";
import wrench from "heroicons/20/solid/wrench-screwdriver.svg?raw";
import xMark from "heroicons/20/solid/x-mark.svg?raw";

const icons = {
  arrowDown, arrowPath, arrowTopRight, arrowUp, arrowsRightLeft, bars3, chartBar, check, chevronDown, chevronRight, codeBracket, cog, cube, exclamation, flag, forward, inbox, lockClosed, magnifyingGlass, moon, pencil, play, plus, star, sun, tag, wrench, xMark,
};
export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className = "size-5" } = Astro.props;
const svg = icons[name].replace("<svg", `<svg class="${className}" aria-hidden="true"`);
---

<Fragment set:html={svg} />
