---
// The queue's title row and filter form (GET, so the filters live in the URL;
// no JS, hence Apply). From `lg` up it is a bar across the split view with the
// filters inline; on phones the same form folds into a <details> whose summary
// names the active filters. One form for both, forced open on desktop through
// ::details-content.
import { LANGUAGES, LANGUAGE_CODES } from "@slop-bucket/core";
import { BAND_KEYS, CONFIDENCE_BANDS, ORDER_KEYS, QUEUE_ORDERS, QUEUE_SOURCES, STAR_FILTER_KEYS, type QueueFilters, starFilterLabels } from "../lib/review.ts";
import { SOURCE_LABELS, btnSecondary, num } from "../lib/ui.ts";

interface Props {
  filters: QueueFilters;
  /** Queued posts matching the filters. */
  matching: number;
  /** All queued posts. */
  total: number;
  /** github_min_stars, for the star filter's labels. */
  minStars: number;
  /** Queued posts per detected language (queueLanguages). */
  languages: Map<string, number>;
}
const { filters, matching, total, minStars, languages } = Astro.props;
const starLabels = starFilterLabels(minStars);
// Only languages the queue holds, in LANGUAGES order (English first, Unknown last), plus the chosen one.
const languageOptions = LANGUAGE_CODES.filter((l) => (languages.get(l) ?? 0) > 0 || filters.language === l);
const filtered = filters.source !== "" || filters.band !== "" || filters.stars !== "" || filters.language !== "";
const active = [
  filters.source && SOURCE_LABELS[filters.source],
  filters.language && LANGUAGES[filters.language],
  filters.band && CONFIDENCE_BANDS[filters.band],
  filters.stars && starLabels[filters.stars],
  filters.order !== "oldest" && QUEUE_ORDERS[filters.order],
].filter(Boolean);
const select = "h-11 w-full rounded-lg bg-white px-2 text-base text-stone-900 outline-1 -outline-offset-1 outline-stone-300 focus:outline-2 focus:-outline-offset-2 focus:outline-lime-600 lg:w-auto lg:text-sm";
const fieldLabel = "text-sm font-medium text-stone-900 lg:sr-only";
---

<div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-2 lg:mb-0 lg:items-center lg:justify-start lg:border-b lg:border-stone-200 lg:bg-white lg:px-6 lg:py-3">
  <h1 class="text-lg font-semibold lg:text-xl lg:font-bold lg:tracking-tight">Review queue</h1>
  <span class="text-sm text-stone-500 lg:font-mono lg:text-xs">
    {filtered ? `${num(matching)} of ${num(total)} waiting` : `${num(total)} waiting`}
  </span>
  <details class="w-full lg:ml-auto lg:w-auto lg:details-content:[content-visibility:visible]">
    <summary class="flex min-h-11 cursor-pointer items-center text-sm font-medium text-lime-700 lg:hidden">
      {active.length ? `Filters: ${active.join(" · ")}` : "Filter and sort"}
    </summary>
    <form method="get" action="/admin/queue" class="grid gap-3 pt-1 pb-2 lg:flex lg:flex-wrap lg:items-center lg:gap-2 lg:p-0" aria-label="Filter the queue">
      <div class="grid gap-1 lg:block">
        <label for="qf-source" class={fieldLabel}>Source</label>
        <select id="qf-source" name="source" class={select}>
          <option value="">All sources</option>
          {QUEUE_SOURCES.map((s) => <option value={s} selected={filters.source === s}>{SOURCE_LABELS[s]}</option>)}
        </select>
      </div>
      <div class="grid gap-1 lg:block">
        <label for="qf-language" class={fieldLabel}>Language</label>
        <select id="qf-language" name="language" class={select}>
          <option value="">Any language</option>
          {languageOptions.map((l) => <option value={l} selected={filters.language === l}>{LANGUAGES[l]} ({num(languages.get(l) ?? 0)})</option>)}
        </select>
      </div>
      <div class="grid gap-1 lg:block">
        <label for="qf-band" class={fieldLabel}>Confidence</label>
        <select id="qf-band" name="band" class={select}>
          <option value="">Any confidence</option>
          {BAND_KEYS.map((b) => <option value={b} selected={filters.band === b}>{CONFIDENCE_BANDS[b]}</option>)}
        </select>
      </div>
      <div class="grid gap-1 lg:block">
        <label for="qf-stars" class={fieldLabel}>GitHub stars</label>
        <select id="qf-stars" name="stars" class={select}>
          <option value="">Any stars</option>
          {STAR_FILTER_KEYS.map((s) => <option value={s} selected={filters.stars === s}>{starLabels[s]}</option>)}
        </select>
      </div>
      <div class="grid gap-1 lg:block">
        <label for="qf-order" class={fieldLabel}>Order</label>
        <select id="qf-order" name="order" class={select}>
          {ORDER_KEYS.map((o) => <option value={o} selected={filters.order === o}>{QUEUE_ORDERS[o]}</option>)}
        </select>
      </div>
      <div class="flex gap-2">
        <button type="submit" class={`${btnSecondary} flex-1 lg:flex-none`}>Apply</button>
        {active.length > 0 && <a href="/admin/queue" class={`${btnSecondary} flex-1 lg:flex-none`}>Clear</a>}
      </div>
    </form>
  </details>
</div>
