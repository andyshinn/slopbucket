---
import { env } from "cloudflare:workers";
import Icon from "../components/Icon.astro";
import { openReportCount } from "../lib/reports-admin.ts";
import Base from "./Base.astro";

interface Props {
  title: string;
  section?: "queue" | "tools" | "reports" | "status" | "settings";
}
const { title, section } = Astro.props;
const email = Astro.locals.adminEmail;
const tabs = [
  { id: "queue", href: "/admin/queue", label: "Queue", icon: "inbox" },
  { id: "tools", href: "/admin/tools", label: "Tools", icon: "wrench" },
  { id: "reports", href: "/admin/reports", label: "Reports", icon: "flag" },
  { id: "status", href: "/admin/status", label: "Status", icon: "chartBar" },
  { id: "settings", href: "/admin/settings", label: "Settings", icon: "cog" },
] as const;
// A badge only: a failed count must not take the whole admin down.
const openReports = await openReportCount(env.DB).catch(() => 0);
---

<Base title={`${title} · Slop Bucket admin`} noindex>
  <header class="sticky top-0 z-10 border-b border-gray-200 bg-white">
    <div class="mx-auto flex h-14 max-w-2xl items-center justify-between gap-4 px-4">
      <a href="/admin/queue" class="flex items-center gap-2 font-semibold text-gray-900">
        <Icon name="inbox" class="size-5 text-brand-600" />
        Slop Bucket admin
      </a>
      {email && <span class="truncate text-sm text-gray-500">{email}</span>}
    </div>
    <nav class="mx-auto grid max-w-2xl grid-cols-5 px-1" aria-label="Admin sections">
      {tabs.map((t) => (
        <a
          href={t.href}
          aria-current={section === t.id ? "page" : undefined}
          class={`flex min-h-11 items-center justify-center gap-1 border-b-2 text-sm font-medium sm:gap-1.5 ${section === t.id ? "border-brand-600 text-brand-700" : "border-transparent text-gray-500 hover:text-gray-900"}`}
        >
          <Icon name={t.icon} class="hidden size-4 sm:block" />
          {t.label}
          {t.id === "reports" && openReports > 0 && (
            <span class="rounded-full bg-lime-400 px-1.5 text-xs font-semibold text-lime-950 tabular-nums">
              {openReports}
              <span class="sr-only"> open</span>
            </span>
          )}
        </a>
      ))}
    </nav>
  </header>
  <main class="mx-auto max-w-2xl px-4 pt-4 pb-40">
    <slot />
  </main>
</Base>
