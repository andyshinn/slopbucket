---
import { env } from "cloudflare:workers";
import { categoryDisplay, getSetting } from "@slop-bucket/core";
import Icon from "../../../../components/Icon.astro";
import Notice from "../../../../components/Notice.astro";
import ToolAvatar from "../../../../components/ToolAvatar.astro";
import Admin from "../../../../layouts/Admin.astro";
import {
  DESCRIPTION_MAX,
  POSTS_ALL,
  POSTS_DEFAULT,
  ToolError,
  addAlias,
  getTool,
  mergeHistory,
  mergedInto,
  oneLine,
  removeAlias,
  setHidden,
  splitMerge,
  updateTool,
} from "../../../../lib/tools-admin.ts";
import { SOURCE_LABELS, btnPrimary, btnReject, btnSecondary, card, input, label, safeHref, timeAgo, toolStatusChip } from "../../../../lib/ui.ts";

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect("/admin/tools", 302);

let error: { section: string; message: string } | null = null;
let submitted: FormData | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action"));
  try {
    if (action === "save") {
      submitted = form;
      await updateTool(env.DB, id, form);
    } else if (action === "add_alias") {
      await addAlias(env.DB, id, String(form.get("kind")), String(form.get("value") ?? ""));
    } else if (action === "remove_alias") {
      await removeAlias(env.DB, id, String(form.get("kind")), String(form.get("value")));
    } else if (action === "split") {
      const { fromId } = await splitMerge(env.DB, Number(form.get("merge_id")));
      return Astro.redirect(`/admin/tools/${fromId}?done=split`, 303);
    } else if (action === "hide" || action === "unhide") {
      await setHidden(env.DB, id, action === "hide");
    } else {
      throw new ToolError("Unknown action.");
    }
    return Astro.redirect(`/admin/tools/${id}?done=${action}${action.includes("alias") ? "#aliases" : ""}`, 303);
  } catch (err) {
    if (!(err instanceof ToolError)) throw err;
    error = { section: action.includes("alias") ? "aliases" : action, message: err.message };
    Astro.response.status = 422;
  }
}

const showAllPosts = Astro.url.searchParams.get("posts") === "all";
const [tool, categories, tagGroups, merges, mergedAway] = await Promise.all([
  getTool(env.DB, id, showAllPosts ? POSTS_ALL : POSTS_DEFAULT),
  getSetting(env.DB, "categories"),
  getSetting(env.DB, "tags"),
  mergeHistory(env.DB, id),
  mergedInto(env.DB, id),
]);
if (!tool) return Astro.redirect("/admin/tools", 302);

// Re-show what was submitted after an error; otherwise the stored values.
const field = (k: string, stored: unknown) => (submitted ? String(submitted.get(k) ?? "") : stored == null ? "" : String(stored));
const selectedTags = new Set(submitted ? submitted.getAll("tags").map(String) : tool.tags);
const openValue = field("is_open_source", tool.is_open_source === null ? "" : tool.is_open_source ? "true" : "false");
const done = Astro.url.searchParams.get("done");
const doneMessage: Record<string, string> = {
  save: "Saved.",
  add_alias: "Alias added.",
  remove_alias: "Alias removed.",
  hide: "Hidden. It no longer appears on public pages.",
  merged: "Merged. The other tool's posts and aliases are now here.",
  split: "Split back out. Its posts and aliases are back here.",
  unhide: "Visible again.",
};
const homepage = safeHref(tool.homepage_url);
// An <input> drops newlines on load, so show (and count) the one-line form that saving stores.
const description = oneLine(field("description", tool.description));
---

<Admin title={`Edit ${tool.name}`} section="tools">
  <a href="/admin/tools" class="text-sm font-medium text-brand-700">← All tools</a>
  <div class="mt-2 flex items-center gap-3">
    <ToolAvatar name={tool.name} category={tool.category ?? "other"} githubRepo={tool.github_repo} class="size-11 rounded-[10px] text-lg" />
    <h1 class="min-w-0 flex-1 text-lg font-semibold break-words">{tool.name}</h1>
    <span class={`shrink-0 rounded-md px-2 py-0.5 text-xs font-medium capitalize ring-1 ring-inset ${toolStatusChip[tool.status]}`}>{tool.status}</span>
  </div>
  <p class="mt-1 text-sm text-stone-600">
    First seen {timeAgo(tool.first_seen_at)} · {tool.postCount} {tool.postCount === 1 ? "post" : "posts"}
    {homepage && <> · <a href={homepage} class="font-medium text-brand-700" target="_blank" rel="noopener noreferrer">Website</a></>}
    {tool.github_repo && <> · <a href={`https://github.com/${tool.github_repo}`} class="font-medium text-brand-700" target="_blank" rel="noopener noreferrer">GitHub</a></>}
  </p>

  {done && doneMessage[done] && <div class="mt-4"><Notice>{doneMessage[done]}</Notice></div>}
  {error?.section === "split" && <div class="mt-4"><Notice tone="error">{error.message}</Notice></div>}
  {mergedAway && (
    <div class="mt-4">
      <Notice>
        Merged into <a href={`/admin/tools/${mergedAway.id}`} class="font-semibold underline">{mergedAway.name}</a>. To undo, use Split on that tool's page.
      </Notice>
    </div>
  )}

  <form method="post" class={`${card} mt-4 space-y-4 p-4`}>
    <input type="hidden" name="action" value="save" />
    {error?.section === "save" && <Notice tone="error">{error.message}</Notice>}
    <div>
      <label for="name" class={label}>Name</label>
      <input id="name" name="name" value={field("name", tool.name)} required class={`${input} mt-1`} autocomplete="off" />
    </div>
    <div>
      <label for="slug" class={label}>Slug <span class="font-normal text-stone-500">(public URL: /tools/slug)</span></label>
      <input id="slug" name="slug" value={field("slug", tool.slug)} required class={`${input} mt-1 font-mono text-sm`} autocomplete="off" autocapitalize="off" />
    </div>
    <div>
      <div class="flex items-baseline justify-between gap-3">
        <label for="description" class={label}>Description</label>
        {/* The admin ships no JS, so this counts the saved text; maxlength stops typing at the cap. */}
        <span class="font-mono text-xs text-stone-500 tabular-nums">{description.length} / {DESCRIPTION_MAX}</span>
      </div>
      <input id="description" name="description" value={description} maxlength={DESCRIPTION_MAX} aria-describedby="description-hint" class={`${input} mt-1`} autocomplete="off" />
      <p id="description-hint" class="mt-1 text-xs text-stone-500">Describe the tool, not a post. One line, up to {DESCRIPTION_MAX} characters.</p>
    </div>
    <div>
      <label for="category" class={label}>Category</label>
      <select id="category" name="category" class={`${input} mt-1`}>
        {categories.map((c) => <option value={c} selected={c === field("category", tool.category)}>{categoryDisplay(c).label}</option>)}
      </select>
    </div>
    <fieldset>
      <legend class={label}>Tags</legend>
      {tagGroups.map((g) => (
        <div class="mt-2">
          <p class="text-xs font-medium text-stone-500">{g.label}</p>
          <div class="mt-1 flex flex-wrap gap-2">
            {g.tags.map((t) => (
              <label class="inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-sm ring-1 ring-stone-300 ring-inset has-checked:bg-brand-50 has-checked:ring-brand-600">
                <input type="checkbox" name="tags" value={t.slug} checked={selectedTags.has(t.slug)} class="size-4 accent-brand-600" />
                {t.label}
              </label>
            ))}
          </div>
        </div>
      ))}
    </fieldset>
    <div>
      <label for="homepage_url" class={label}>Homepage</label>
      <input id="homepage_url" name="homepage_url" type="url" value={field("homepage_url", tool.homepage_url)} class={`${input} mt-1`} autocomplete="off" autocapitalize="off" />
    </div>
    <div>
      <label for="github_repo" class={label}>GitHub repo <span class="font-normal text-stone-500">(owner/repo)</span></label>
      <input id="github_repo" name="github_repo" value={field("github_repo", tool.github_repo)} class={`${input} mt-1 font-mono text-sm`} autocomplete="off" autocapitalize="off" />
    </div>
    <fieldset>
      <legend class={label}>Source</legend>
      <div class="mt-1 grid grid-cols-3 gap-1 rounded-lg bg-stone-100 p-1">
        {[["true", "Open source"], ["false", "Closed"], ["", "Unknown"]].map(([value, text]) => (
          <label class="flex min-h-11 cursor-pointer items-center justify-center rounded-md px-2 text-center text-sm font-medium text-stone-600 has-checked:bg-white has-checked:text-stone-900 has-checked:shadow-xs has-checked:ring-1 has-checked:ring-stone-200 has-focus-visible:outline-2 has-focus-visible:outline-lime-600">
            <input type="radio" name="is_open_source" value={value} checked={openValue === value} class="sr-only" />
            {text}
          </label>
        ))}
      </div>
    </fieldset>
    <p class="text-xs text-stone-500">A new repo, homepage domain or name is also added as an alias, so future posts land here.</p>
    <button type="submit" class={`${btnPrimary} w-full`}>Save changes</button>
  </form>

  <section id="aliases" class="mt-6 scroll-mt-28">
    <h2 class="text-lg font-semibold">Aliases</h2>
    <p class="mt-1 text-sm text-stone-600">New posts with any of these repos, domains or names resolve to this tool.</p>
    {error?.section === "aliases" && <div class="mt-2"><Notice tone="error">{error.message}</Notice></div>}
    <ul class={`${card} mt-2 divide-y divide-stone-100`}>
      {tool.aliases.length === 0 && <li class="p-4 text-sm text-stone-600">No aliases.</li>}
      {tool.aliases.map((a) => (
        <li class="flex items-center justify-between gap-3 py-1 pr-1 pl-4">
          <span class="min-w-0">
            <span class="mr-2 rounded bg-stone-100 px-1.5 py-0.5 font-mono text-xs font-medium text-stone-600">{a.kind}</span>
            <span class="font-mono text-sm break-all">{a.value}</span>
            {a.via_merge && <span class="ml-2 text-xs whitespace-nowrap text-stone-500">via merge</span>}
          </span>
          <form method="post">
            <input type="hidden" name="action" value="remove_alias" />
            <input type="hidden" name="kind" value={a.kind} />
            <input type="hidden" name="value" value={a.value} />
            <button type="submit" class="flex size-11 items-center justify-center rounded-lg text-stone-400 hover:bg-stone-50 hover:text-red-700" aria-label={`Remove alias ${a.value}`}>
              <Icon name="xMark" />
            </button>
          </form>
        </li>
      ))}
    </ul>
    <h3 class="mt-3 text-sm font-medium text-stone-900">+ Add alias</h3>
    <form method="post" class="mt-1 grid grid-cols-[auto_1fr_auto] gap-2">
      <input type="hidden" name="action" value="add_alias" />
      <select name="kind" aria-label="Alias kind" class={input}>
        <option value="repo">repo</option>
        <option value="domain">domain</option>
        <option value="name">name</option>
      </select>
      <input name="value" placeholder="owner/repo, example.dev or a name" aria-label="Alias value" required class={input} autocomplete="off" autocapitalize="off" />
      <button type="submit" class={btnSecondary}>Add alias</button>
    </form>
  </section>

  {merges.length > 0 && (
    <section class="mt-6">
      <h2 class="text-lg font-semibold">Merge history</h2>
      <ul class={`${card} mt-2 divide-y divide-stone-100`}>
        {merges.map((m) => (
          <li class="flex items-center justify-between gap-3 px-4 py-3">
            <span class="min-w-0 text-sm">
              <a href={`/admin/tools/${m.from_tool_id}`} class="font-medium text-stone-900 hover:text-brand-700">{m.from_name}</a>
              <span class="block text-stone-500">
                Merged {timeAgo(m.merged_at)} · {m.posts} {m.posts === 1 ? "post" : "posts"}, {m.aliases} {m.aliases === 1 ? "alias" : "aliases"}
              </span>
            </span>
            <form method="post">
              <input type="hidden" name="action" value="split" />
              <input type="hidden" name="merge_id" value={m.id} />
              <button type="submit" class={`${btnSecondary} shrink-0`}>Split back out</button>
            </form>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section id="posts" class="mt-6 scroll-mt-28">
    <h2 class="text-lg font-semibold">Posts</h2>
    <ul class={`${card} mt-2 divide-y divide-stone-100`}>
      {tool.posts.length === 0 && <li class="p-4 text-sm text-stone-600">No posts.</li>}
      {tool.posts.map((p) => (
        <li class="flex items-center justify-between gap-3 px-4 py-3">
          <span class="min-w-0">
            <a href={safeHref(p.url) ?? "#"} class="block font-medium break-words text-stone-900 hover:text-brand-700" target="_blank" rel="noopener noreferrer">{p.title}</a>
            <span class="block text-sm text-stone-500">
              {SOURCE_LABELS[p.source] ?? p.source} · {timeAgo(p.posted_at)}{p.post_type && ` · ${p.post_type}`} · {p.status}
            </span>
          </span>
          {p.status === "queued" && (
            <a href={`/admin/queue/${p.id}/reassign`} class={`${btnSecondary} shrink-0`}>Move</a>
          )}
        </li>
      ))}
    </ul>
    {tool.postCount > tool.posts.length && (
      <p class="mt-2 flex items-center justify-between gap-3 text-sm text-stone-500">
        Showing the latest {tool.posts.length} of {tool.postCount.toLocaleString("en")}.
        {!showAllPosts && <a href={`/admin/tools/${id}?posts=all#posts`} class="inline-flex min-h-11 items-center font-medium text-lime-700 hover:underline">Show all</a>}
      </p>
    )}
  </section>

  {!mergedAway && (
    <section class="mt-6">
      <h2 class="text-lg font-semibold">Other actions</h2>
      <div class={`${card} mt-2 space-y-4 p-4`}>
        <div>
          <p class="text-sm text-stone-600">Same tool listed twice? Move this one's posts and aliases into the other.</p>
          <a href={`/admin/tools/${id}/merge`} class={`${btnSecondary} mt-2 w-full`}>
            <Icon name="arrowsRightLeft" class="size-4 text-stone-500" /> Merge into another tool
          </a>
        </div>
        <div class="border-t border-stone-100 pt-4">
          <p class="text-sm text-stone-600">
            Hidden tools disappear from public pages. Their posts stay linked, so new posts about them stay hidden too.
          </p>
          <form method="post" class="mt-2">
            <input type="hidden" name="action" value={tool.status === "hidden" ? "unhide" : "hide"} />
            <button type="submit" class={`${tool.status === "hidden" ? btnSecondary : btnReject} w-full`}>
              {tool.status === "hidden" ? "Show this tool again" : "Hide this tool"}
            </button>
          </form>
        </div>
      </div>
    </section>
  )}
</Admin>
