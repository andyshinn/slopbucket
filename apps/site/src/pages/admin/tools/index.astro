---
import { env } from "cloudflare:workers";
import { getSetting } from "@slop-bucket/core";
import Icon from "../../../components/Icon.astro";
import Admin from "../../../layouts/Admin.astro";
import { PAGE_SIZE, TOOL_SORTS, listTools, toolStatusCounts } from "../../../lib/tools-admin.ts";
import { btnPrimary, btnSecondary, card, input, label, timeAgo } from "../../../lib/ui.ts";

const params = Astro.url.searchParams;
const q = (params.get("q") ?? "").trim();
const status = params.get("status") ?? "";
const category = params.get("category") ?? "";
const sort = params.get("sort") ?? "trending";
const page = Math.max(1, Number(params.get("page")) || 1);

const [{ tools, total }, counts, categories] = await Promise.all([
  listTools(env.DB, { q, status, category, sort, page }),
  toolStatusCounts(env.DB),
  getSetting(env.DB, "categories"),
]);
const all = Object.values(counts).reduce((a, b) => a + b, 0);
const tabs = [
  ["", "All", all],
  ["published", "Published", counts.published ?? 0],
  ["queued", "Queued", counts.queued ?? 0],
  ["hidden", "Hidden", counts.hidden ?? 0],
] as const;

/** This page's URL with some parameters changed ("" removes one). */
function link(changes: Record<string, string | number>): string {
  const next = new URLSearchParams(params);
  for (const [k, v] of Object.entries(changes)) {
    if (v === "" || v === undefined) next.delete(k);
    else next.set(k, String(v));
  }
  if (!("page" in changes)) next.delete("page");
  const s = next.toString();
  return `/admin/tools${s ? `?${s}` : ""}`;
}
const statusChip: Record<string, string> = {
  published: "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
  queued: "bg-amber-50 text-amber-800 ring-amber-600/20",
  hidden: "bg-stone-100 text-stone-600 ring-stone-500/20",
};
const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
---

<Admin title="Tools" section="tools">
  <h1 class="text-lg font-semibold">Tools</h1>

  <form method="get" class="mt-3 flex gap-2" role="search">
    {status && <input type="hidden" name="status" value={status} />}
    {category && <input type="hidden" name="category" value={category} />}
    {sort !== "trending" && <input type="hidden" name="sort" value={sort} />}
    <input type="search" name="q" value={q} placeholder="Name, repo or domain" aria-label="Search tools" class={input} autocomplete="off" autocapitalize="off" />
    <button type="submit" class={btnPrimary} aria-label="Search"><Icon name="magnifyingGlass" /></button>
  </form>

  <nav class="mt-3 flex gap-1 overflow-x-auto border-b border-stone-200" aria-label="Status">
    {tabs.map(([value, text, n]) => (
      <a
        href={link({ status: value })}
        aria-current={status === value ? "page" : undefined}
        class={`flex min-h-11 shrink-0 items-center gap-1.5 border-b-2 px-3 text-sm font-medium ${status === value ? "border-stone-900 text-stone-900" : "border-transparent text-stone-500 hover:text-stone-900"}`}
      >
        {text}
        <span class={`rounded-full px-1.5 text-xs tabular-nums ${status === value ? "bg-brand-100 text-brand-700" : "bg-stone-100 text-stone-600"}`}>{n.toLocaleString()}</span>
      </a>
    ))}
  </nav>

  <form method="get" class="mt-3 grid grid-cols-[1fr_1fr_auto] items-end gap-2">
    {q && <input type="hidden" name="q" value={q} />}
    {status && <input type="hidden" name="status" value={status} />}
    <div>
      <label for="category" class={label}>Category</label>
      <select id="category" name="category" class={`${input} mt-1`}>
        <option value="">All</option>
        {categories.map((c) => <option value={c} selected={c === category}>{c}</option>)}
      </select>
    </div>
    <div>
      <label for="sort" class={label}>Sort</label>
      <select id="sort" name="sort" class={`${input} mt-1`}>
        {Object.entries(TOOL_SORTS).map(([value, text]) => <option value={value} selected={value === sort}>{text}</option>)}
      </select>
    </div>
    <button type="submit" class={btnSecondary}>Apply</button>
  </form>

  <p class="mt-4 text-sm text-stone-600">
    {total.toLocaleString()} {total === 1 ? "tool" : "tools"}{q && <> matching “{q}”</>}
  </p>
  <ul class={`${card} mt-2 divide-y divide-stone-100`}>
    {tools.length === 0 && <li class="p-4 text-sm text-stone-600">No tools match.</li>}
    {tools.map((t) => (
      <li>
        <a href={`/admin/tools/${t.id}`} class="flex min-h-16 items-center justify-between gap-3 px-4 py-3 hover:bg-stone-50">
          <span class="min-w-0">
            <span class="flex items-center gap-2">
              <span class="truncate font-medium text-stone-900">{t.name}</span>
              <span class={`shrink-0 rounded-md px-1.5 py-0.5 text-xs font-medium ring-1 ring-inset ${statusChip[t.status]}`}>{t.merged_into ? "merged" : t.status}</span>
            </span>
            {t.github_repo && <span class="block truncate font-mono text-xs text-stone-500">{t.github_repo}</span>}
            <span class="block text-sm text-stone-500">
              {t.category ?? "uncategorized"} · {t.posts} {t.posts === 1 ? "post" : "posts"}
              {t.last_post_at && ` · ${timeAgo(t.last_post_at)}`}
              {t.is_open_source === 0 && " · closed source"}
              {t.merged_into && ` · into ${t.merged_into}`}
            </span>
          </span>
          <Icon name="pencil" class="size-5 shrink-0 text-stone-400" />
        </a>
      </li>
    ))}
  </ul>

  {pages > 1 && (
    <nav class="mt-4 flex items-center justify-between" aria-label="Pages">
      {page > 1 ? <a href={link({ page: page - 1 })} class={btnSecondary}>Previous</a> : <span />}
      <span class="text-sm text-stone-600">Page {page} of {pages}</span>
      {page < pages ? <a href={link({ page: page + 1 })} class={btnSecondary}>Next</a> : <span />}
    </nav>
  )}
</Admin>
