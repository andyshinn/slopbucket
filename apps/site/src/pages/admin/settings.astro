---
import { env } from "cloudflare:workers";
import Notice from "../../components/Notice.astro";
import ThresholdHistogram from "../../components/ThresholdHistogram.astro";
import Admin from "../../layouts/Admin.astro";
import { settingSchemas } from "@slop-bucket/core";
import {
  REASONING_LEVELS,
  SETTING_FIELDS,
  SettingError,
  WEIGHT_KEYS,
  loadSettings,
  saveSetting,
  queuedScores,
  thresholdHistogram,
} from "../../lib/settings-admin.ts";
import { accentLink, btnPrimary, card, input, label } from "../../lib/ui.ts";

// Errors and the submitted (unsaved) values, so a rejected edit is not lost.
let failed: { key: string; message: string; form: FormData } | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const key = String(form.get("key"));
  try {
    await saveSetting(env.DB, key, form);
    return Astro.redirect(`/admin/settings?saved=${encodeURIComponent(key)}#${key}`, 303);
  } catch (err) {
    if (!(err instanceof SettingError)) throw err;
    failed = { key, message: err.message, form };
    Astro.response.status = 422;
  }
}

const saved = Astro.url.searchParams.get("saved");
const [values, scores] = await Promise.all([loadSettings(env.DB), queuedScores(env.DB)]);
// Validated, not cast: a bad stored value hides the histogram but leaves the page usable to fix it.
const threshold = settingSchemas.review_threshold.safeParse(values.review_threshold);
const histogram = threshold.success ? thresholdHistogram(scores, threshold.data) : null;
const WEIGHT_LABELS: Record<string, string> = { w_s: "Sources", w_e: "Engagement", w_g: "Star growth", g: "Gravity" };

// Value shown in a field: what was just submitted if it failed, else what is stored.
function shown(key: string, name = "value"): string {
  if (failed?.key === key) return String(failed.form.get(name) ?? "");
  const v = values[key];
  if (name !== "value") return String((v as Record<string, unknown> | undefined)?.[name] ?? "");
  return Array.isArray(v) ? v.join("\n") : String(v ?? "");
}
---

<Admin title="Settings" section="settings">
  <h1 class="text-lg font-semibold">Settings</h1>
  <p class="mt-1 text-sm text-stone-600">Changes apply to the next job; no deploy needed. Saving one says how to apply it to posts already stored.</p>
  <p class="mt-2 text-sm text-stone-600">Tags and categories are on <a href="/admin/taxonomy" class={accentLink}>Tags &amp; categories</a>.</p>

  <div class="mt-4 space-y-4">
    {
      SETTING_FIELDS.map((f) => (
        <form method="post" id={f.key} class={`${card} scroll-mt-28 p-4`}>
          <input type="hidden" name="key" value={f.key} />
          {saved === f.key && (
            <Notice>
              Saved. {f.afterSave.text}
              {f.afterSave.link && (
                <>
                  {" "}
                  <a href={f.afterSave.link.href} class="font-semibold underline">{f.afterSave.link.label}</a>
                </>
              )}
            </Notice>
          )}
          {failed?.key === f.key && <Notice tone="error">{failed.message}</Notice>}

          {f.kind === "weights" ? (
            <fieldset>
              <legend class={label}>{f.label}</legend>
              <div class="mt-2 grid grid-cols-2 gap-3">
                {WEIGHT_KEYS.map((w) => (
                  <div>
                    <label for={`${f.key}-${w}`} class="block text-xs text-stone-600">
                      {WEIGHT_LABELS[w]}
                    </label>
                    <input id={`${f.key}-${w}`} name={w} type="number" step="any" inputmode="decimal" value={shown(f.key, w)} class={`${input} mt-1`} />
                  </div>
                ))}
              </div>
            </fieldset>
          ) : (
            <>
              <label for={`${f.key}-value`} class={label}>
                {f.label}
              </label>
              {f.kind === "lines" ? (
                <textarea id={`${f.key}-value`} name="value" rows="6" class={`${input} mt-1 font-mono text-sm`} autocapitalize="off" spellcheck="false">{shown(f.key)}</textarea>
              ) : f.kind === "reasoning" ? (
                <select id={`${f.key}-value`} name="value" class={`${input} mt-1`}>
                  {REASONING_LEVELS.map((r) => (
                    <option value={r} selected={shown(f.key) === r}>
                      {r || "(none sent)"}
                    </option>
                  ))}
                </select>
              ) : (
                <input
                  id={`${f.key}-value`}
                  name="value"
                  type={f.kind === "text" ? "text" : "number"}
                  step={f.kind === "integer" ? "1" : "any"}
                  inputmode={f.kind === "text" ? undefined : f.kind === "integer" ? "numeric" : "decimal"}
                  value={shown(f.key)}
                  class={`${input} mt-1`}
                  autocomplete="off"
                  autocapitalize="off"
                />
              )}
            </>
          )}
          <p class="mt-2 text-xs text-stone-500">{f.help}</p>
          <button type="submit" class={`${btnPrimary} mt-3 w-full`}>Save {f.label.toLowerCase()}</button>
          {f.key === "review_threshold" && histogram && threshold.success && <ThresholdHistogram histogram={histogram} threshold={threshold.data} />}
        </form>
      ))
    }
  </div>
</Admin>
