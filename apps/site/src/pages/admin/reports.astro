---
import { env } from "cloudflare:workers";
import Icon from "../../components/Icon.astro";
import Notice from "../../components/Notice.astro";
import Admin from "../../layouts/Admin.astro";
import { listReports, reasonLabel, resolveReport } from "../../lib/reports-admin.ts";
import { btnPrimary, btnSecondary, card, timeAgo } from "../../lib/ui.ts";

const showResolved = Astro.url.searchParams.get("show") === "resolved";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = Number(form.get("id"));
  let ok = false;
  if (form.get("action") === "resolve" && Number.isInteger(id) && id > 0) ok = await resolveReport(env.DB, id);
  // Only a report this POST actually resolved gets the notice; a double tap just lands on the list.
  return Astro.redirect(ok ? `/admin/reports?resolved=${id}` : "/admin/reports", 303);
}
const justResolved = Number(Astro.url.searchParams.get("resolved")) || null;

const reports = await listReports(env.DB, showResolved);
---

<Admin title="Reports" section="reports">
  <div class="mb-3 flex items-baseline justify-between">
    <h1 class="text-lg font-semibold">{showResolved ? "Resolved reports" : "Reports"}</h1>
    {!showResolved && <span class="text-sm text-gray-500">{reports.length} open</span>}
  </div>

  {justResolved && <Notice>Report resolved.</Notice>}

  {
    reports.length === 0 && !showResolved && (
      <div class={`${card} px-4 py-10 text-center`}>
        <Icon name="flag" class="mx-auto size-6 text-gray-400" />
        <p class="mt-2 font-semibold text-gray-900">No open reports</p>
        <p class="mt-1 text-sm text-gray-600">Nobody has complained about anything. Enjoy it.</p>
      </div>
    )
  }
  {reports.length === 0 && showResolved && <p class="text-sm text-gray-600">No resolved reports yet.</p>}

  <ul class="space-y-3">
    {
      reports.map((r) => (
        <li class={`${card} p-4`}>
          <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
            <span class="rounded-md bg-amber-50 px-2 py-0.5 font-medium text-amber-800 ring-1 ring-amber-200 ring-inset">{reasonLabel(r.reason)}</span>
            <span>{timeAgo(r.created_at)}</span>
            {r.resolved_at && <span>· resolved {timeAgo(r.resolved_at)}</span>}
          </div>
          <p class="mt-2">
            <a href={`/tools/${r.tool_slug}`} class="font-semibold text-gray-900 hover:underline">
              {r.tool_name}
            </a>
            {r.tool_status !== "published" && <span class="ml-1 text-sm text-gray-500">({r.tool_status})</span>}
          </p>
          {r.note && <blockquote class="mt-2 border-l-2 border-gray-200 pl-3 text-sm whitespace-pre-wrap text-gray-700">{r.note}</blockquote>}
          {!r.resolved_at && (
            <div class="mt-4 grid grid-cols-2 gap-2">
              <a href={`/admin/tools/${r.tool_id}`} class={btnSecondary}>
                <Icon name="wrench" class="size-5 text-gray-500" /> Open tool
              </a>
              <form method="post">
                <input type="hidden" name="id" value={r.id} />
                <button type="submit" name="action" value="resolve" class={`${btnPrimary} w-full`}>
                  <Icon name="check" /> Resolve
                </button>
              </form>
            </div>
          )}
        </li>
      ))
    }
  </ul>

  <p class="mt-6 text-center text-sm">
    {
      showResolved ? (
        <a href="/admin/reports" class="font-medium text-brand-700 hover:underline">Back to open reports</a>
      ) : (
        <a href="/admin/reports?show=resolved" class="font-medium text-brand-700 hover:underline">Show resolved reports</a>
      )
    }
  </p>
</Admin>
