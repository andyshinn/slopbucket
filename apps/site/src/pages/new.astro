---
import { env } from "cloudflare:workers";
import BrowseList from "../components/BrowseList.astro";
import Public from "../layouts/Public.astro";
import { loadBrowsePage } from "../lib/browse.ts";

const page = await loadBrowsePage(env.DB, Astro.url, "/new", "new");
if (page.redirect) return Astro.redirect(page.redirect, 302);
---

<Public title="New · Slop Bucket" description="The newest AI dev tools in the bucket, by when we first saw them." nav="new">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="mb-8">
      <h1 class="text-4xl font-bold tracking-tight">New in the bucket</h1>
      <p class="mt-2 text-stone-600 dark:text-stone-300">Tools by when we first saw them, newest first.</p>
    </div>
    <BrowseList base="/new" defaultSort="new" {...page} />
  </div>
</Public>
