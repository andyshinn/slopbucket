---
import { getSetting } from "@slop-bucket/core";
import { env } from "cloudflare:workers";
import ToolRow from "../components/ToolRow.astro";
import Public from "../layouts/Public.astro";
import { PAGE_SIZE, compactNumber, homeStats, pageParam, runTime, trendingTools } from "../lib/public.ts";

const page = pageParam(Astro.url.searchParams.get("page"));
const [{ tools, total }, stats, tagGroups] = await Promise.all([trendingTools(env.DB, page), homeStats(env.DB), getSetting(env.DB, "tags")]);
const lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE));
if (page > lastPage) return Astro.redirect(lastPage === 1 ? "/" : `/?page=${lastPage}`, 302);

const tagLabels = new Map(tagGroups.flatMap((g) => g.tags.map((t) => [t.slug, t.label] as const)));
const first = total === 0 ? 0 : (page - 1) * PAGE_SIZE + 1;
const last = Math.min(page * PAGE_SIZE, total);
const pageHref = (n: number) => (n === 1 ? "/" : `/?page=${n}`);
const statItems = [
  { label: "In the bucket", value: stats.tools, muted: false },
  { label: "Posts read", value: stats.postsRead, muted: false },
  { label: "Tossed out", value: stats.tossed, muted: true },
];
const pagerLink =
  "inline-flex min-h-11 items-center rounded-lg px-4 text-sm font-semibold ring-1 ring-stone-300 ring-inset hover:bg-stone-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-600 dark:ring-stone-700 dark:hover:bg-stone-800 dark:focus-visible:outline-lime-400";
---

<Public title="Slop Bucket: trending AI dev tools" description="Every AI dev tool the internet posted about, ranked by who's talking about it." nav="trending">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        {
          stats.lastRun && (
            <p class="flex items-center gap-2 font-mono text-xs tracking-widest text-stone-500 uppercase dark:text-stone-400">
              <span class="size-2 rounded-full bg-lime-400" aria-hidden="true" />
              Updated daily · last run {runTime(stats.lastRun)}
            </p>
          )
        }
        <h1 class="mt-3 text-4xl font-bold tracking-tighter sm:text-5xl/none">Trending in the <span class="highlight">bucket</span></h1>
        <p class="mt-4 max-w-2xl text-lg text-stone-600 dark:text-stone-300">
          Every AI dev tool the internet posted about, ranked by who's talking about it. Sorted. Mostly.
        </p>
      </div>
      <dl class="flex gap-8 font-mono">
        {
          statItems.map((s) => (
            <div>
              <dt class="text-xs tracking-widest text-stone-500 uppercase dark:text-stone-400">{s.label}</dt>
              <dd class={`mt-1 text-2xl font-bold tabular-nums ${s.muted ? "text-stone-500 dark:text-stone-400" : ""}`} title={s.value.toLocaleString("en")}>
                {compactNumber(s.value)}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <section class="mt-10" aria-labelledby="list-heading">
      <h2 id="list-heading" class="text-sm text-stone-600 dark:text-stone-300">
        <span class="font-semibold text-stone-900 dark:text-stone-50">{total.toLocaleString("en")} {total === 1 ? "tool" : "tools"}</span>, ranked by sources, chatter and star
        growth. <a href="/about#ranking" class="font-medium text-lime-700 hover:underline dark:text-lime-400">How ranking works</a>
      </h2>

      {
        tools.length > 0 ? (
          <ol class="mt-4 divide-y divide-stone-200 overflow-hidden rounded-xl bg-white shadow-xs ring-1 ring-stone-200 dark:divide-stone-800 dark:bg-stone-900 dark:ring-stone-800">
            {tools.map((tool, i) => (
              <ToolRow tool={tool} rank={first + i} tagLabels={tagLabels} />
            ))}
          </ol>
        ) : (
          <div class="mt-4 rounded-xl bg-white px-6 py-12 text-center ring-1 ring-stone-200 dark:bg-stone-900 dark:ring-stone-800">
            <p class="font-semibold">The bucket is empty.</p>
            <p class="mt-1 text-stone-600 dark:text-stone-300">Nothing has made it through review yet. Check back after the next run.</p>
          </div>
        )
      }

      {
        total > PAGE_SIZE && (
          <nav class="mt-6 flex items-center justify-between gap-4" aria-label="Pagination">
            <p class="font-mono text-xs text-stone-500 tabular-nums dark:text-stone-400">
              {first}–{last} of {total.toLocaleString("en")}
            </p>
            <div class="flex gap-2">
              {page > 1 && (
                <a href={pageHref(page - 1)} rel="prev" class={pagerLink}>
                  Previous
                </a>
              )}
              {page < lastPage && (
                <a href={pageHref(page + 1)} rel="next" class={pagerLink}>
                  Next page
                </a>
              )}
            </div>
          </nav>
        )
      }
    </section>
  </div>
</Public>
